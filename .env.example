# App URL (local). On Render this is injected as RENDER_EXTERNAL_URL.
SHIMAI_APP_URL=http://localhost:3000
SHIMAI_ALLOWED_ORIGINS=http://localhost:3000

# Twilio (server-only, optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Render production ---
# Blueprint: render.yaml
# Required on Render (set when the Blueprint prompts, or in Environment):
#   SUPABASE_SERVICE_ROLE_KEY
# Optional on Render:
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#   STRIPE_SECRET_KEY          (also set on Edge Function `checkout`)
#   STRIPE_WEBHOOK_SECRET
#   TWILIO_ACCOUNT_SID
#   TWILIO_AUTH_TOKEN
#   TWILIO_PHONE_NUMBER
# After first deploy, update Supabase Edge Function secrets:
#   SHIMAI_APP_URL=https://shimai.onrender.com
#   SHIMAI_ALLOWED_ORIGINS=https://shimai.onrender.com
