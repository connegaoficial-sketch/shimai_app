# Supabase (server-only — never expose to the browser)
# Required for checkout delivery quotes, admin, and webhooks.
# Copy from Supabase Dashboard → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
# Stripe (server-only for Edge Function `checkout`)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
